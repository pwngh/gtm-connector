[0.232686, "o", "1. Run the fixture demo\r\n\r\nActual execution. Dependency and test logs are captured privately.\r\n$ ./scripts/demo.sh --state-dir var/recording-d0o8fva5/state\r\n"]
[58.363756, "o", "Selected output:\r\nTest suite: OK (231 tests in 51.611 seconds)\r\nAccounts: 30\r\n"]
[58.363769, "o", "Call-note scope denial: HTTP 403\r\n"]
