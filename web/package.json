{
  "name": "gtm-connector-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/vite/bin/vite.js build",
    "test": "npm run typecheck && npm run lint && node --test 'src/**/*.test.ts'",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p .",
    "lint": "node node_modules/@biomejs/biome/bin/biome check",
    "format": "node node_modules/@biomejs/biome/bin/biome check --write",
    "test:browser": "node scripts/api-browser.mjs"
  },
  "dependencies": {
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
